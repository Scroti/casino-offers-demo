# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
*.log

# credentials & secrets
base64.txt
*.pem
*.p12
*.key
*service-account*.json
*credentials*.json

# binary installers & local artifacts
*.msi
*.exe
*.dmg
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.webp

# env files (can opt-in for committing if needed)
.env*
*.json
!package.json
!package-lock.json
!components.json
!tsconfig.json
!next.config.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
